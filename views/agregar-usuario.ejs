<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agregar</title>
<style>
body{background:#000;color:#fff;font-family:Arial;margin:0}
.header{background:#0a0a0a;padding:12px 15px;display:flex;justify-content:space-between;border-bottom:2px solid #ff0000}
.box{background:#151515;border:1px solid #222;border-radius:12px;margin:15px;padding:18px}
input,select{width:100%;padding:12px;margin:8px 0;background:#111;border:1px solid #333;border-radius:8px;color:white}
label{font-size:12px;color:#888;margin-top:8px;display:block}
.btn{width:100%;padding:12px;border-radius:25px;border:none;font-weight:bold;cursor:pointer;margin-top:12px}
.btn-red{background:#ff0000;color:white}
.btn-dark{background:#222;color:white;text-decoration:none;display:block;text-align:center;padding:12px;border-radius:25px;margin-top:10px}
</style>
</head>
<body>
<div class="header"><b style="color:#ff0000">▶ REMIX APP</b><div>Creditos: <%= db.credits %></div></div>
<div class="box">
<h2 style="color:#ff0000;text-align:center">+ Agregar Cliente</h2>
<form method="POST" action="/agregar-usuario">
<label>Nombre</label><input type="text" name="nombre" required>
<label>Email</label><input type="email" name="email" required>
<label>Contraseña</label><input type="text" name="password" value="1234" required>
<label>Tipo</label>
<select name="tipo">
<option value="Premium">PREMIUM - 30 días</option>
<option value="Demo">DEMO - 1 hora</option>
</select>
<label>Dispositivos</label>
<select name="dispositivos">
<option value="1">1 Dispositivo</option>
<option value="2">2</option>
<option value="3">3</option>
</select>
<button class="btn btn-red" type="submit">Crear Cliente</button>
<a href="/dashboard" class="btn-dark">Volver</a>
</form>
</div>
</body>
</html>
