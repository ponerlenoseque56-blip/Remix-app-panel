<!DOCTYPE html>
<html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Panel Remix</title>
<style>body{background:#000;color:#fff;font-family:sans-serif;padding:15px} .top{display:flex;justify-content:space-between} .stats{display:flex;gap:10px;margin:15px 0} .box{background:#111;padding:12px;border-radius:10px;flex:1;text-align:center} table{width:100%;border-collapse:collapse;margin-top:15px} th,td{padding:10px;border-bottom:1px solid #222;text-align:left;font-size:13px} .btn{border:none;padding:7px 10px;border-radius:6px;color:#fff;margin:2px;font-weight:bold} .green{background:#00c853} .blue{background:#2962ff} .red{background:#d50000} a{color:#fff;text-decoration:none}</style>
</head><body>
<div class="top"><h2>REMIX</h2><div>Creditos: <b><%= db.credits %></b> | <a href="/logout">Salir</a></div></div>
<div class="stats"><div class="box">Total<br><b><%= total %></b></div><div class="box">Premium<br><b><%= premium %></b></div><div class="box">Demos<br><b><%= demos %></b></div></div>
<a href="/agregar-usuario"><button class="btn blue" style="width:100%;padding:12px">+ CREAR USUARIO</button></a>
<table><tr><th>Cliente</th><th>Acciones</th></tr>
<% db.users.forEach(function(u){ %>
<tr><td><b><%= u.nombre %></b><br><small><%= u.email %> | <%= u.password %></small><br><small><%= u.tipo %> - <%= u.vencimiento %></small></td>
<td>
<button class="btn green" onclick="renovar('<%= u.email %>')">+30D</button>
<button class="btn blue" onclick="editar('<%= u.email %>','<%= u.password %>')">CLAVE</button>
<button class="btn red" onclick="borrar('<%= u.email %>')">X</button>
</td></tr>
<% }) %>
</table>
<script>
function renovar(email){
  if(!confirm('Renovar '+email+' por 30 dias? Te consume 1 credito.')) return;
  fetch('/api/renew-user',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email})})
  .then(r=>r.json()).then(d=>{ if(d.ok){ alert('Renovado hasta '+d.vencimiento); location.reload(); } else { alert('Error al renovar'); } });
}
function editar(email,actual){
  let n = prompt('Nueva clave para '+email, actual);
  if(!n) return;
  fetch('/api/edit-user',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email,password:n})})
  .then(r=>r.json()).then(d=>{ if(d.ok){ alert('Clave cambiada'); location.reload(); } else { alert('Error'); } });
}
function borrar(email){
  if(!confirm('Borrar '+email+'?')) return;
  fetch('/api/delete-user',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email})})
  .then(()=>location.reload());
}
</script>
</body></html>
