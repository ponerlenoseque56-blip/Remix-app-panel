<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>2026 REMIX APP v1.0</title>
<style>
body{background:#000;color:#fff;font-family:Arial;margin:0;padding:0}
.header{background:#111;padding:12px 15px;display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #ff0000}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;padding:15px}
.stat{background:#1a1a1a;border:1px solid #333;border-radius:10px;padding:15px;text-align:center}
.stat.red{background:#cc0000;border:none}
.stat h2{margin:0;font-size:24px}
.credits-box{background:#1a1a1a;border:1px solid #ff0000;padding:10px;margin:10px 15px;display:flex;justify-content:space-between;align-items:center;border-radius:8px}
input.cred{width:80px;background:#000;color:#fff;border:1px solid #ff0000;padding:6px;border-radius:6px;text-align:center}
.btn{padding:8px 14px;border-radius:20px;border:none;font-weight:bold;cursor:pointer}
.btn-red{background:#ff0000;color:white} 
.btn-dark{background:#333;color:white}
.actions{padding:0 15px;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
table{width:100%;border-collapse:collapse;margin-top:10px}
th{background:#ff0000;padding:8px;font-size:12px}
td{padding:10px;text-align:center;border-bottom:1px solid #222;font-size:13px}
.premium{color:#ff0000;font-weight:bold} 
.demo{color:#888}
.search{width:90%;margin:0 15px 10px 15px;padding:10px;background:#111;border:1px solid #333;color:white;border-radius:8px;box-sizing:border-box}
</style>
</head>
<body>

<div class="header">
<div style="color:#ff0000;font-weight:bold">▶ REMIX APP</div>
<div style="font-size:13px"><%= username %> • Créditos: <%= db.credits %> <a href="/logout" class="btn btn-dark" style="margin-left:8px;text-decoration:none;font-size:12px">Salir</a></div>
</div>

<div class="stats">
<div class="stat red"><h2><%= total %></h2><small>TOTAL<br>CLIENTES</small></div>
<div class="stat red"><h2><%= premium %></h2><small>PREMIUM<br>ACTIVOS</small></div>
<div class="stat"><h2><%= demos %></h2><small>DEMOS<br>ACTIVOS</small></div>
<div class="stat"><h2>0</h2>
