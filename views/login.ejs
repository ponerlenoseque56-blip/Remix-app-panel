<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ff0000">
<link rel="manifest" href="/manifest.json">
<title>REMIX APP - Login</title>
<style>
body{background:#000;color:#fff;font-family:Arial;margin:0;display:flex;flex-direction:column;align-items:center;min-height:100vh}
.logo{margin-top:20px;text-align:center}
.circle{width:200px;height:200px;margin:20px auto;border-radius:50%;background:radial-gradient(circle,#4a0000,#000);border:3px solid #ff0000;box-shadow:0 0 40px #ff0000;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:60px;color:#ff0000}
.login-box{width:90%;max-width:400px;margin-top:auto;margin-bottom:60px;background:#111;padding:20px;border-radius:16px;border:1px solid #333;box-shadow:0 0 20px rgba(255,0,0,.2)}
.input-group{display:flex;margin-bottom:12px;background:#222;border-radius:8px;overflow:hidden;border-left:4px solid #ff0000}
.input-group .icon{width:50px;background:#ff0000;display:flex;align-items:center;justify-content:center;font-size:20px}
.input-group input{flex:1;background:#2a2a2a;border:none;padding:14px;color:#fff;outline:none}
.btn{width:100%;background:#ff0000;padding:14px;border:none;border-radius:8px;color:#fff;font-weight:bold;cursor:pointer;box-shadow:0 0 15px rgba(255,0,0,.5);font-size:16px}
.error{background:#4a0000;color:#ff4444;padding:10px;border-radius:6px;text-align:center;margin-bottom:10px;border:1px solid #ff0000}
</style>
</head>
<body>
<div class="logo">
<h1 style="color:#ff0000;margin:0;letter-spacing:2px">REMIX APP</h1>
<p style="font-size:13px;opacity:.6">Ingresa al sistema para gestionar<br>los clientes.</p>
<div class="circle">▶</div>
</div>
<div class="login-box">
<h3>Entrar al sistema</h3>
<p style="font-size:13px;opacity:.6">Ingresa tu usuario y contraseña del Revendedor.</p>
<% if(error){ %><div class="error"><%= error %></div><% } %>
<form method="POST" action="/login">
<div class="input-group"><div class="icon">👤</div><input name="user" placeholder="Usuario" required></div>
<div class="input-group"><div class="icon">🔒</div><input type="password" name="pass" placeholder="Contraseña" required></div>
<button class="btn">Iniciar Session</button>
</form>
<p style="text-align:center;font-size:11px;opacity:.4;margin-top:15px">© 2024 REMIX APP • Panel Revendedor v2.1 ROJO</p>
</div>
<script>if('serviceWorker' in navigator){ navigator.serviceWorker.register('/sw.js'); }</script>
</body>
</html>
