<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>REMIX APP - Login</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#000;color:#fff;font-family:Arial;display:flex;flex-direction:column;min-height:100vh;align-items:center;justify-content:center}
.logo h1{color:#ff0000;text-align:center;font-size:32px;letter-spacing:2px;margin:0}
.logo p{opacity:.6;font-size:13px;text-align:center;margin:5px 0 0}
.circle{width:200px;height:200px;border:2px solid #ff0000;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:25px auto;box-shadow:0 0 30px rgba(255,0,0,.6);background:radial-gradient(circle,#1a0000,#000)}
.circle span{font-size:70px;color:#ff0000;margin-left:10px}
.box{background:#111;border:1px solid #222;padding:20px;border-radius:16px;width:90%;max-width:380px;margin-top:30px;border-top:2px solid #ff0000}
.box h3{margin:0 0 5px} .box small{opacity:.5}
.field{position:relative;margin-top:14px;display:flex;align-items:center;background:#222;border-radius:8px;border:1px solid #333}
.field:focus-within{border-color:#ff0000}
.field .icon{background:#ff0000;padding:12px;border-radius:8px 0 0 8px;min-width:44px;text-align:center}
.field input{flex:1;background:transparent;border:none;padding:12px;color:#fff;outline:none}
.eye{padding:10px 12px;cursor:pointer;user-select:none;opacity:.7}
.eye:hover{opacity:1}
.btn{width:100%;background:#ff0000;color:#fff;border:none;padding:14px;border-radius:8px;font-weight:bold;margin-top:14px;cursor:pointer;font-size:15px}
.footer{text-align:center;font-size:11px;opacity:.4;margin-top:14px;letter-spacing:1px}
.error{background:#4a0000;border:1px solid #ff0000;color:#ff7777;padding:8px;border-radius:6px;font-size:12px;margin-top:10px;text-align:center}
..wa{position:fixed;bottom:20px;right:20px;background:#25D366;width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(0,0,0,.5);text-decoration:none}ms:center;justify-content:center;font-size:28px;box-shadow:0 4px 12px rgba(0,0,0,.5);text-decoration:none}
</style>
</head>
<body>

<div class="logo">
<h1>REMIX APP</h1>
<p>Ingresa al sistema para gestionar<br>los clientes.</p>
<div class="circle"><span>▶</span></div>
</div>

<div class="box">
<h3>Entrar al sistema</h3>
<small>Ingresa tu usuario y contraseña del Revendedor.</small>

<% if (typeof error !== 'undefined' && error) { %>
<div class="error"><%= error %></div>
<% } %>

<form method="POST" action="/login">
<div class="field">
<div class="icon">👤</div>
<input name="username" placeholder="Usuario" required>
</div>

<div class="field">
<div class="icon">🔒</div>
<input id="passInput" name="password" type="password" placeholder="Contraseña" required>
<span class="eye" id="toggleEye" onclick="togglePass()">👁️</span>
</div>

<button class="btn" type="submit">Iniciar Session</button>
<div class="footer">© 2026 REMIX APP • Panel Revendedor v1.0 ROJO</div>
</form>
</div>

<a class="wa" href="https://wa.me/5492644580690" target="_blank">
<svg viewBox="0 0 24 24" width="30" height="30" fill="white"><path d="M19.11 4.93C17.06 2.88 14.25 1.75 11.25 1.75C5.28 1.75 0.45 6.58 0.45 12.55C0.45 14.45 0.95 16.3 1.89 17.95L0.15 23.5L5.86 21.76C7.43 22.62 9.28 23.08 11.25 23.08H11.26C17.23 23.08 22.06 18.25 22.06 12.28C22.06 9.28 20.93 6.47 19.11 4.93ZM11.26 21.08C9.66 21.08 8.1 20.65 6.78 19.85L6.45 19.65L2.94 20.57L3.88 17.19L3.65 16.83C2.76 15.42 2.29 13.79 2.29 12.11C2.29 7.17 6.31 3.15 11.25 3.15C13.64 3.15 15.89 4.08 17.58 5.77C19.27 7.46 20.2 9.71 20.2 12.1C20.2 17.05 16.18 21.08 11.26 21.08ZM16.2 14.38C15.92 14.24 14.55 13.56 14.29 13.47C14.03 13.37 13.85 13.32 13.66 13.6C13.47 13.88 12.92 14.56 12.75 14.75C12.58 14.94 12.41 14.96 12.13 14.82C11.85 14.68 10.95 14.38 9.88 13.43C9.05 12.69 8.49 11.77 8.32 11.49C8.15 11.21 8.3 11.06 8.44 10.92C8.56 10.8 8.72 10.6 8.86 10.43C9 10.26 9.05 10.14 9.14 9.95C9.23 9.76 9.18 9.6 9.11 9.46C9.04 9.32 8.48 7.95 8.24 7.38C8.01 6.83 7.77 6.9 7.6 6.89C7.43 6.88 7.25 6.88 7.06 6.88C6.87 6.88 6.57 6.95 6.31 7.23C6.05 7.51 5.33 8.19 5.33 9.56C5.33 10.93 6.33 12.25 6.47 12.44C6.61 12.63 8.4 15.38 11.11 16.58C13.85 17.79 13.85 17.41 14.32 17.36C14.79 17.31 15.85 16.69 16.07 16.04C16.29 15.39 16.29 14.83 16.22 14.71C16.15 14.59 15.96 14.52 15.68 14.38H16.2Z"/></svg>
</a>
<script>
function togglePass(){
  const input = document.getElementById('passInput');
  const eye = document.getElementById('toggleEye');
  if(input.type === 'password'){
    input.type = 'text';
    eye.textContent = '🙈';
  } else {
    input.type = 'password';
    eye.textContent = '👁️';
  }
}
</script>

</body>
</html>
